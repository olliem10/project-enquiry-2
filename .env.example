# Copy this file to .env.local and fill in real values.
# .env.local is gitignored — never commit real secrets.

# --- Supabase (Project Settings -> API) ---
# Safe to expose to the browser (protected by Row Level Security).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Email notifications (Resend: https://resend.com) ---
# Optional for local development: if RESEND_API_KEY is unset, the app logs a
# warning and skips sending instead of failing the enquiry submission.
RESEND_API_KEY=
# Verified "from" address for outgoing mail. Falls back to Resend's shared
# onboarding@resend.dev sender (no domain verification needed) if unset.
EMAIL_FROM=
# Who receives "new enquiry" notifications.
NOTIFICATION_EMAIL=olliemicklefield@gmail.com

# --- Admin ---
# Base URL used to build the "open in admin" link in notification emails.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
